---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCover from '../components/ProjectCover.astro';
import {
  profile,
  metrics,
  focus,
  strengths,
  certifications,
  skills,
  experience,
  education,
  internalTools,
} from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const allSkills = skills.flatMap((s) => s.items);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base home>
  <canvas class="scene" aria-hidden="true"></canvas>
  <div class="scene-fade" aria-hidden="true"></div>

  <main id="top">
    <div class="scene-zone">
      <!-- ================= HERO ================= -->
      <section class="hero">
        <div class="shell hero__inner">
          <div class="hero__meta mono" data-reveal>
            <span><span class="live-dot"></span> En poste · {profile.company}</span>
            <span>{profile.location} — <span data-clock>--:--</span></span>
          </div>

          <h1 class="hero__name" aria-label={profile.name}>
            <span class="line" data-split>Samuel</span>
            <span class="line line--indent" data-split><span class="serif">Van Der</span> Hoeven</span>
          </h1>

          <div class="hero__bottom">
            <p class="hero__role" data-reveal>
              <span class="mono accent">{profile.role}</span>
              Ingénieur réseaux & télécoms, master en cyberdéfense. Je structure, sécurise et fusionne des systèmes
              d'information — et je construis les outils qui vont avec.
            </p>
            <div class="hero__actions" data-reveal>
              <a class="btn btn--solid" href="#projets" data-magnetic>
                Explorer les projets
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" /></svg>
              </a>
              <a class="btn" href="#contact" data-magnetic>Me contacter</a>
            </div>
          </div>
        </div>
        <a class="scroll-cue mono" href="#profil" aria-label="Défiler vers le profil">
          <span>Scroll</span><span class="scroll-cue__bar"></span>
        </a>
      </section>

      <!-- ================= PROFIL ================= -->
      <section class="section profil" id="profil">
        <div class="shell">
          <p class="section-label mono"><span class="index">01</span> Profil</p>
          <p class="manifesto" data-scrub>
            Je pilote des systèmes d'information <em class="serif">lisibles, résilients</em> et réellement exploitables.
            Comprendre le besoin, fiabiliser l'existant, documenter, et livrer des solutions qui tiennent dans le temps.
          </p>

          <div class="profil__grid">
            <figure class="portrait" data-reveal data-cursor="Bonjour">
              <div class="portrait__frame">
                <img src="/img/Sujet.webp" alt={`Portrait de ${profile.name}`} width="1336" height="1967" data-parallax="0.06" />
              </div>
              <figcaption class="mono">
                <span>{profile.location}</span>
                <span>{profile.languages}</span>
              </figcaption>
            </figure>

            <div class="profil__story">
              <div class="story" data-reveal>
                <p>
                  Aujourd'hui <strong>{profile.role.toLowerCase()} chez {profile.company}</strong>, je pilote la
                  structuration et la sécurisation du système d'information dans un contexte de fusion entre plusieurs
                  écoles. Le rôle couvre autant la stratégie que l'opérationnel : parc, accès, outils, procédures,
                  documentation, support et amélioration continue.
                </p>
                <p>
                  Chez <strong>CGI à Toulouse</strong>, j'ai participé à une analyse de risques <strong>EBIOS RM</strong> sur un système critique et à un audit SSI structuré autour d'ISO 27001, du NIST CSF et des
                  recommandations ANSSI, avec des scripts d'automatisation pour fiabiliser la gestion des accès.
                </p>
                <p>
                  En parallèle, comme <strong>co-associé et directeur technique de MASC-IT</strong>, j'ai mené des
                  projets pour des PME, associations et particuliers : parc, supervision, sauvegardes, administration
                  Windows / Linux, sites web et bases de données.
                </p>
              </div>

              <div class="profil__cols">
                <div class="panel" data-reveal>
                  <h3 class="mono">Focus actuel</h3>
                  <ul class="list">{focus.map((f) => <li>{f}</li>)}</ul>
                </div>
                <div class="panel" data-reveal>
                  <h3 class="mono">Ce que j'apporte</h3>
                  <ul class="list">{strengths.map((s) => <li>{s}</li>)}</ul>
                </div>
              </div>

              <div class="panel panel--inline" data-reveal>
                <h3 class="mono">Certifications & repères</h3>
                <div class="chips">{certifications.map((c) => <span class="chip">{c}</span>)}</div>
              </div>
            </div>
          </div>

          <div class="metrics">
            {
              metrics.map((m) => (
                <div class="metric" data-reveal>
                  <span class="metric__value">
                    <span data-count={m.value}>{m.value}</span>
                    <span class="accent">{m.suffix}</span>
                  </span>
                  <span class="metric__label mono">{m.label}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </div>

    <!-- ================= MARQUEE ================= -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track" data-marquee>
        {[...allSkills, ...allSkills].map((s) => <span class="marquee__item">{s}<i>✦</i></span>)}
      </div>
    </div>

    <!-- ================= EXPERTISE ================= -->
    <section class="section expertise" id="expertise">
      <div class="shell">
        <p class="section-label mono"><span class="index">02</span> Expertise</p>
        <h2 class="title split-title" data-split>
          Des briques solides, <span class="serif">regroupées par usage.</span>
        </h2>
        <ol class="skill-rows">
          {
            skills.map((group, i) => (
              <li class="skill-row" data-reveal>
                <span class="skill-row__index mono">{pad(i + 1)}</span>
                <h3 class="skill-row__title">{group.title}</h3>
                <div class="chips">
                  {group.items.map((item) => (
                    <span class="chip">{item}</span>
                  ))}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ================= PARCOURS ================= -->
    <section class="section parcours" id="parcours">
      <div class="shell">
        <p class="section-label mono"><span class="index">03</span> Parcours</p>
        <h2 class="title split-title" data-split>
          Du terrain <span class="serif">à la direction SI.</span>
        </h2>
        <div class="timeline-cols">
          <div>
            <h3 class="col-title mono">Expériences</h3>
            <ol class="timeline">
              {
                experience.map((e) => (
                  <li class={`tl-item ${e.current ? 'is-current' : ''}`} data-reveal>
                    <span class="tl-item__period mono">{e.period}</span>
                    <div>
                      <h4>{e.title}</h4>
                      <p class="tl-item__org">{e.org}</p>
                      <p class="tl-item__text">{e.text}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
          <div>
            <h3 class="col-title mono">Formation</h3>
            <ol class="timeline">
              {
                education.map((e) => (
                  <li class="tl-item" data-reveal>
                    <span class="tl-item__period mono">{e.period}</span>
                    <div>
                      <h4>{e.title}</h4>
                      <p class="tl-item__org">{e.org}</p>
                      <p class="tl-item__text">{e.text}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PROJETS ================= -->
    <section class="section projets" id="projets">
      <div class="shell">
        <p class="section-label mono"><span class="index">04</span> Projets</p>
        <div class="projets__head">
          <h2 class="title split-title" data-split>
            Cybersécurité, infra, <span class="serif">produit et usage réel.</span>
          </h2>
          <p class="projets__count mono">{pad(projects.length + internalTools.length)} projets</p>
        </div>

        <div class="featured">
          {
            featured.map((p, i) => (
              <a class="feature" href={`/projets/${p.id}/`} data-reveal data-cursor="Voir">
                <div class="feature__media" data-tilt="4">
                  <ProjectCover project={p} />
                  <span class="feature__shine" />
                </div>
                <div class="feature__body">
                  <span class="mono feature__index">
                    {pad(i + 1)} — {p.data.eyebrow}
                  </span>
                  <h3 class="feature__title">{p.data.title}</h3>
                  <p>{p.data.summary}</p>
                  <div class="chips">
                    {p.data.stack.slice(0, 5).map((s) => (
                      <span class="chip">{s}</span>
                    ))}
                  </div>
                  <span class="mono feature__year">{p.data.year}</span>
                </div>
              </a>
            ))
          }
        </div>

        <div class="grid">
          {
            others.map((p) => (
              <a class="card" href={`/projets/${p.id}/`} data-reveal data-cursor="Voir">
                <div class="card__media" data-tilt="5">
                  <ProjectCover project={p} />
                </div>
                <div class="card__meta mono">
                  <span>{p.data.eyebrow}</span>
                  <span>{p.data.year}</span>
                </div>
                <h3 class="card__title">{p.data.title}</h3>
                <p class="card__text">{p.data.summary}</p>
              </a>
            ))
          }
        </div>

        <div class="internal" data-reveal>
          <div class="internal__head">
            <h3 class="mono">En poste · outils internes</h3>
            <p>Développés pour mon poste actuel. Décrits sans données internes, le code n'est pas public.</p>
          </div>
          <ul class="internal__list">
            {
              internalTools.map((t) => (
                <li class="tool" data-reveal>
                  <span class="tool__status mono">{t.status}</span>
                  <h4>{t.title}</h4>
                  <p>{t.text}</p>
                  <div class="chips">
                    {t.stack.map((s) => (
                      <span class="chip">{s}</span>
                    ))}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    <section class="section contact" id="contact">
      <div class="contact__glow" aria-hidden="true"></div>
      <div class="shell">
        <p class="section-label mono"><span class="index">05</span> Contact</p>
        <h2 class="display contact__title" data-split>
          Parlons SI, <span class="serif">cyber</span> ou projets techniques.
        </h2>
        <a class="contact__mail" href={`mailto:${profile.email}`} data-magnetic="0.15" data-cursor="Écrire">
          {profile.email}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
        </a>
        <div class="contact__row">
          <p class="contact__note" data-reveal>
            En poste, je ne recherche pas de nouvelle opportunité. Je reste ouvert aux échanges, retours d'expérience et
            discussions autour de la sécurité, des infrastructures et de l'automatisation.
          </p>
          <ul class="contact__links" data-reveal>
            <li><a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn <span>↗</span></a></li>
            <li><a href={profile.github} target="_blank" rel="noopener">GitHub <span>↗</span></a></li>
            <li><a href={profile.cv} download>CV (PDF) <span>↓</span></a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.scene');
  const zone = document.querySelector('.scene-zone');
  if (canvas && zone) {
    // fade the scene out once the profile section is behind us
    const fade = () => {
      const r = zone.getBoundingClientRect();
      const o = Math.max(0, Math.min(1, (r.bottom - innerHeight * 0.2) / (innerHeight * 0.6)));
      canvas.style.setProperty('--o', String(o));
    };
    fade();
    addEventListener('scroll', fade, { passive: true });

    // Three.js is ~130 KB gzipped: load it once the page is painted and idle
    const boot = () => import('../scripts/scene').then(({ initScene }) => initScene(canvas, zone));
    const idle = (cb: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 1500 }) : setTimeout(cb, 200);
    if (document.readyState === 'complete') idle(boot);
    else addEventListener('load', () => idle(boot), { once: true });
  }
</script>

<style>
  /* ---------- Scene ---------- */
  .scene {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  .scene:global(.is-ready) {
    opacity: var(--o, 1);
  }
  .scene-fade {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 120%, rgba(140, 123, 255, 0.12), transparent 60%),
      linear-gradient(to bottom, transparent 70%, var(--bg));
  }
  main {
    position: relative;
    z-index: 1;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 120px 0 clamp(48px, 8vh, 96px);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
  }
  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    color: var(--muted);
  }
  .live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(110, 255, 201, 0.6);
    animation: pulse 2s infinite;
    vertical-align: 1px;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgba(110, 255, 201, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(110, 255, 201, 0);
    }
  }
  .hero__name {
    display: flex;
    flex-direction: column;
    font-size: min(13.5vw, 17svh, 228px);
    line-height: 0.86;
    letter-spacing: -0.06em;
    font-weight: 500;
    margin-left: -0.04em;
  }
  .hero__name .line--indent {
    padding-left: clamp(0px, 9vw, 160px);
  }
  .hero__name .serif {
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
  }
  .hero__role {
    max-width: 560px;
    color: var(--muted);
    font-size: clamp(16px, 1.4vw, 19px);
  }
  .hero__role .mono {
    display: block;
    margin-bottom: 10px;
  }
  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .scroll-cue {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--dim);
    writing-mode: vertical-rl;
  }
  .scroll-cue__bar {
    width: 1px;
    height: 64px;
    background: linear-gradient(var(--accent), transparent);
    animation: drip 2.2s var(--ease) infinite;
    transform-origin: top;
  }
  @keyframes drip {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  /* ---------- Profil ---------- */
  .manifesto {
    max-width: 1180px;
    font-size: clamp(28px, 4.2vw, 64px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 500;
  }
  .manifesto em {
    color: var(--accent);
  }
  .profil__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(64px, 10vw, 140px);
    align-items: start;
  }
  .portrait {
    margin: 0;
    position: sticky;
    top: 100px;
  }
  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: radial-gradient(circle at 50% 30%, rgba(110, 255, 201, 0.18), transparent 60%), var(--bg-2);
  }
  .portrait__frame img {
    position: absolute;
    inset: -6% 0 auto;
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.8s var(--ease);
  }
  .portrait:hover img {
    filter: grayscale(0);
  }
  .portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    color: var(--dim);
    font-size: 11px;
  }
  .profil__story {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .story {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: clamp(17px, 1.35vw, 20px);
    color: var(--muted);
  }
  .story strong {
    color: var(--text);
    font-weight: 500;
  }
  .profil__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .panel {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    backdrop-filter: blur(10px);
  }
  .panel h3 {
    color: var(--accent);
    margin-bottom: 16px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    color: var(--muted);
  }
  .list li {
    position: relative;
    padding-left: 18px;
  }
  .list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 1px;
    background: var(--accent);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(64px, 10vw, 140px);
    border-top: 1px solid var(--line);
  }
  .metric {
    padding: 28px 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .metric + .metric {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }
  .metric__value {
    font-size: clamp(48px, 7vw, 104px);
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 500;
  }
  .metric__label {
    color: var(--muted);
  }

  /* ---------- Marquee ---------- */
  .marquee {
    position: relative;
    overflow: hidden;
    padding: 28px 0;
    border-block: 1px solid var(--line);
    background: var(--bg);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 32px;
    padding-right: 32px;
    font-size: clamp(28px, 4vw, 56px);
    letter-spacing: -0.03em;
    font-weight: 500;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.35);
  }
  .marquee__item:nth-child(3n) {
    color: var(--text);
    -webkit-text-stroke: 0;
  }
  .marquee__item i {
    font-style: normal;
    font-size: 0.5em;
    color: var(--accent);
    -webkit-text-stroke: 0;
  }

  /* ---------- Expertise ---------- */
  .expertise,
  .parcours,
  .projets,
  .contact {
    background: var(--bg);
  }
  .split-title {
    max-width: 1000px;
  }
  .skill-rows {
    list-style: none;
    margin: clamp(48px, 7vw, 96px) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .skill-row {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px;
    align-items: center;
    padding: 32px 0;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }
  .skill-row::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -1);
    z-index: -1;
    background: linear-gradient(90deg, rgba(110, 255, 201, 0.07), transparent 70%);
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .skill-row:hover::before {
    opacity: 1;
  }
  .skill-row__index {
    color: var(--dim);
  }
  .skill-row__title {
    font-size: clamp(22px, 2.4vw, 36px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 500;
    transition: transform 0.5s var(--ease), color 0.5s;
  }
  .skill-row:hover .skill-row__title {
    transform: translateX(12px);
    color: var(--accent);
  }
  .skill-row .chip {
    transition: border-color 0.4s, color 0.4s;
  }
  .skill-row:hover .chip {
    border-color: var(--line-hi);
    color: var(--text);
  }

  /* ---------- Parcours ---------- */
  .timeline-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(48px, 7vw, 96px);
  }
  .col-title {
    color: var(--muted);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl-item {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 20px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .tl-item__period {
    color: var(--dim);
    padding-top: 6px;
  }
  .tl-item h4 {
    margin: 0;
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .tl-item__org {
    margin-top: 4px;
    color: var(--accent);
    font-size: 15px;
  }
  .tl-item__text {
    margin-top: 10px;
