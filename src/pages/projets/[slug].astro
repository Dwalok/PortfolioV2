---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Base title={`${data.title} — Samuel Van Der Hoeven`} description={data.summary}>
  <main class="project" style={`--h: ${data.hue}`}>
    <div class="project__glow" aria-hidden="true"></div>

    <header class="shell project__head">
      <a class="back mono" href="/#projets" data-magnetic="0.2">← Tous les projets</a>
      <p class="mono project__eyebrow" data-reveal>{data.eyebrow} · {data.year}</p>
      <h1 class="project__title" data-split>{data.title}</h1>
      <p class="project__summary" data-reveal>{data.summary}</p>
      {
        data.links.length > 0 && (
          <div class="project__links" data-reveal>
            {data.links.map((l) => (
              <a class="btn btn--sm" href={l.href} target="_blank" rel="noopener" data-magnetic="0.2">
                {l.label} ↗
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="shell">
      <div class="project__cover">
        <ProjectCover project={project} eager />
      </div>
    </div>

    <div class="shell project__layout">
      <aside class="project__aside">
        <dl class="facts">
          {
            data.facts.map((f) => (
              <div class="fact" data-reveal>
                <dt class="mono">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="fact" data-reveal>
          <p class="mono fact__label">Stack</p>
          <div class="chips">{data.stack.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
      </aside>

      <article class="prose" data-reveal>
        <Content />
      </article>
    </div>

    {
      data.gallery.length > 0 && (
        <section class="shell gallery" aria-label="Galerie">
          {data.gallery.map((g) => (
            <figure class="gallery__item" data-reveal>
              <div class="gallery__frame" data-tilt="3">
                <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
              </div>
              <figcaption class="mono">{g.alt}</figcaption>
            </figure>
          ))}
        </section>
      )
    }

    <a class="next" href={`/projets/${next.id}/`} data-cursor="Suivant">
      <div class="shell next__inner">
        <span class="mono">Projet suivant</span>
        <span class="next__title">{next.data.title} <span class="serif">→</span></span>
      </div>
    </a>
  </main>
</Base>

<style>
  .project {
    position: relative;
    overflow: clip;
  }
  .project__glow {
    position: absolute;
    top: -30vh;
    left: 50%;
    width: 110vw;
    height: 90vh;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, hsl(var(--h) 90% 60% / 0.18), transparent 65%);
    pointer-events: none;
  }
  .project__head {
    position: relative;
    padding-top: clamp(130px, 18vh, 200px);
    padding-bottom: clamp(40px, 6vw, 72px);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .back {
    align-self: flex-start;
    color: var(--muted);
    transition: color 0.3s;
  }
  .back:hover {
    color: var(--accent);
  }
  .project__eyebrow {
    color: hsl(var(--h) 90% 70%);
    margin-top: 24px;
  }
  .project__title {
    font-size: clamp(64px, 14vw, 220px);
    line-height: 0.86;
    letter-spacing: -0.06em;
    font-weight: 500;
    margin-left: -0.04em;
  }
  .project__summary {
    max-width: 760px;
    font-size: clamp(19px, 1.8vw, 26px);
    line-height: 1.4;
    color: var(--muted);
    letter-spacing: -0.01em;
  }
  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .project__cover {
    position: relative;
    aspect-ratio: 21 / 9;
    border-radius: calc(var(--radius) + 6px);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .project__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project__layout {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(32px, 7vw, 120px);
    padding-top: clamp(64px, 9vw, 130px);
    padding-bottom: clamp(64px, 9vw, 130px);
    align-items: start;
  }
  .project__aside {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .facts {
    margin: 0;
  }
  .fact {
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }
  .fact dt,
  .fact__label {
    color: var(--dim);
    margin-bottom: 6px;
  }
  .fact dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }
  .fact .chips {
    margin-top: 10px;
  }

  .prose {
    max-width: 760px;
    color: var(--muted);
    font-size: clamp(17px, 1.3vw, 19px);
    line-height: 1.7;
  }
  .prose :global(h2) {
    margin: 2.4em 0 0.7em;
    color: var(--text);
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin: 0 0 1em;
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 500;
  }
  .prose :global(a) {
    color: var(--accent);
    border-bottom: 1px solid currentColor;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 0;
    list-style: none;
  }
  .prose :global(ol) {
    counter-reset: n;
  }
  .prose :global(li) {
    position: relative;
    padding: 12px 0 12px 36px;
    border-top: 1px solid var(--line);
  }
  .prose :global(li:last-child) {
    border-bottom: 1px solid var(--line);
  }
  .prose :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 1.45em;
    width: 12px;
    height: 1px;
    background: hsl(var(--h) 90% 65%);
  }
  .prose :global(ol > li) {
    counter-increment: n;
  }
  .prose :global(ol > li)::before {
    content: counter(n, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 15px;
    font-family: var(--mono);
    font-size: 12px;
    color: hsl(var(--h) 90% 65%);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    padding-bottom: clamp(80px, 10vw, 160px);
  }
  .gallery__item {
    margin: 0;
  }
  .gallery__item:first-child:nth-last-child(odd) {
    grid-column: 1 / -1;
  }
  .gallery__frame {
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .gallery__frame img {
    width: 100%;
    height: auto;
    transition: transform 1.2s var(--ease);
  }
  .gallery__item:hover img {
    transform: scale(1.03);
  }
  .gallery figcaption {
    margin-top: 12px;
    color: var(--dim);
    font-size: 11px;
  }

  .next {
    display: block;
    border-top: 1px solid var(--line);
    padding: clamp(48px, 8vw, 120px) 0;
    transition: background 0.6s var(--ease);
  }
  .next:hover {
    background: hsl(var(--h) 60% 50% / 0.06);
  }
  .next__inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .next .mono {
    color: var(--dim);
  }
  .next__title {
    font-size: clamp(48px, 9vw, 150px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    font-weight: 500;
    transition: color 0.4s, transform 0.6s var(--ease);
  }
  .next:hover .next__title {
    color: var(--accent);
    transform: translateX(16px);
  }

  @media (max-width: 820px) {
    .project__layout {
      grid-template-columns: 1fr;
    }
    .project__aside {
      position: relative;
      top: 0;
    }
    .project__cover {
      aspect-ratio: 4 / 3;
    }
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
